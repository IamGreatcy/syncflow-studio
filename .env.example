# Server Configuration
HOST=0.0.0.0
PORT=3001
APP_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:5173
# Optional: Require a passcode (HTTP Basic Auth / Bearer) when hosting on a public Cloud URL
STUDIO_PASSCODE=
# 64-char hex string (32 bytes) for AES-256-GCM encryption of OAuth tokens & API keys
# Leave empty in local dev to auto-generate data/.master.key
ENCRYPTION_KEY=

# Optional: Cloudflare R2 / S3-compatible Object Storage (recommended for IG/TikTok PULL_FROM_URL)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Optional: OAuth Credentials for Official APIs (can also be configured or used with Simulation mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional: AI Metadata Generator (Gemini or OpenAI-compatible)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Optional: Unified API Fallback (Upload-Post / Zernio)
UNIFIED_API_BASE_URL=
UNIFIED_API_KEY=

# Optional: Failure / Success Notification Webhook (Discord / Slack / Custom JSON)
NOTIFICATION_WEBHOOK_URL=
